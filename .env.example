# Replace every placeholder before deployment.
CHAINLIT_AUTH_SECRET=replace-with-at-least-32-random-characters
LINGXI_MASTER_KEY=replace-with-an-independent-32-character-secret
LINGXI_ADMIN_USERNAME=admin
LINGXI_ADMIN_PASSWORD=replace-with-a-strong-admin-password

POSTGRES_DB=lingxinext
POSTGRES_USER=lingxinext
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql+asyncpg://lingxinext:replace-with-a-strong-database-password@postgres:5432/lingxinext
LINGXIGRAPH_POSTGRES_URL=postgresql://lingxinext:replace-with-a-strong-database-password@postgres:5432/lingxinext

LINGXI_HOST=0.0.0.0
LINGXI_PORT=8123
LINGXI_LOG_LEVEL=INFO
